# Recommended clangd settings for Renesas projects. Managed by the Renesas Platform extension.
# Delete these two lines to keep your own changes; set "renesas-platform.clangdCheckProjectSettings" to false to turn the check off.
CompileFlags:
    BuiltinHeaders: QueryDriver
    CompilationDatabase: ''
Diagnostics:
    UnusedIncludes: None
    Suppress: "pp_including_mainfile_in_preamble"

# This file was automatically generated by RASC

# This CMake script executes FSP-CLI to regenerate project files from the current
# device configuration (as specified in configuration.xml). Typically this
# is executed as a pre-configure step when the device configuration
# or preceding smart bundle of the project has changed:
#
#
# Changing the device configuration currently also regenerates the content of
# the cmake files so this needs to run as a separate step.
#

message(STATUS "BUILD_TYPE ${BUILD_TYPE}")
cmake_path(NORMAL_PATH BINARY_DIR)
cmake_path(NORMAL_PATH SOURCE_DIR)
message(STATUS "BINARY_DIR ${BINARY_DIR}")
message(STATUS "SOURCE_DIR ${SOURCE_DIR}")

# The directory containing this script; used to locate the configuration.xml
# and Config.cmake irrespective of the caller directory
include(${SOURCE_DIR}/Config.cmake)

set_property(DIRECTORY APPEND PROPERTY
		ADDITIONAL_CLEAN_FILES
		"${BINARY_DIR}/rasc_timestamp.txt"
	)
if (EXISTS "${BINARY_DIR}/rasc_timestamp.txt" )
	file(TIMESTAMP "${BINARY_DIR}/rasc_timestamp.txt" TS_LAST_CG "%s" UTC)
	file(TIMESTAMP "${SOURCE_DIR}/configuration.xml" TS_CONFIG "%s" UTC)
	message(STATUS "Configuration.xml timestamp  : ${TS_CONFIG}")
	message(STATUS "Content generation timestamp : ${TS_LAST_CG}")
else()
	SET(TS_LAST_CG "0")
	SET(TS_CONFIG "1")
endif()

if (TS_CONFIG LESS TS_LAST_CG)
    message(STATUS "Skipping content generation since configuration.xml is not updated since the last content generation")
else()
	message("Running RASC for generating project ${PROJECT_NAME} content since modification is detected in configuration.xml:")

    if (EXISTS "${BINARY_DIR}/rasc_timestamp.txt")
       file(REMOVE "${BINARY_DIR}/rasc_timestamp.txt")
    endif()

	string(TIMESTAMP START_TIME "%s")
	execute_process(
		COMMAND_ECHO STDOUT
		COMMAND
			${RASC_EXE_PATH} -nosplash --launcher.suppressErrors
			--generate
			--devicefamily ra
			--compiler LLVMARM
			--buildconfiguration ${BUILD_TYPE}
			${SOURCE_DIR}/configuration.xml
		ERROR_VARIABLE stderr_output
		RESULT_VARIABLE resultVar
		TIMEOUT 600
	)
	string(TIMESTAMP END_TIME "%s")
	math(EXPR ELAPSED "${END_TIME} -  ${START_TIME}")
	message("RASC content generation took: ${ELAPSED} seconds")
	if (resultVar AND NOT resultVar EQUAL 0)
		string(STRIP "${stderr_output}" stderr_output)
	    file(WRITE
        	"${BINARY_DIR}/rasc_conf_cmd_err.txt"
        	"${stderr_output}")
		message(FATAL_ERROR "RASC Execution is failed: ${resultVar}, ${stderr_output} check rasc_conf_cmd_err.txt for details ")
	else()
	    if (NOT EXISTS "${BINARY_DIR}")
	    	file(MAKE_DIRECTORY "${BINARY_DIR}")
    	endif()
		file(TOUCH "${BINARY_DIR}/rasc_timestamp.txt")
	endif()
endif()
